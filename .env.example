RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: hosted error tracking (Sentry). Leave blank to disable.
# When set, src/utils/monitoring.js is ready to forward uncaught errors.
REACT_APP_SENTRY_DSN=

# Optional: Supabase. Powers the digest signup form and upset-alert push.
# Leave blank for localStorage-only mode. See supabase/SETUP.md.
# These two are PUBLIC: Vite inlines them into the browser bundle.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# ── Email digest (data-pipeline/buildDigest.js) ─────────────────────────────
# Where your own copy goes. Comma-separated; subscribers are read separately
# from the digest_subscribers table and do not belong here.
DIGEST_TO=

# Pick ONE transport.
#
# A) Gmail SMTP - no domain required, so this works today. GMAIL_APP_PASSWORD
#    is a Google App Password (myaccount.google.com/apppasswords), which only
#    appears once 2-Step Verification is on for that account. Paste it with or
#    without the spaces Google shows. Mail is sent AS GMAIL_USER: Gmail will
#    not let you forge a different From, so DIGEST_FROM is ignored here.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# B) Resend - needs a domain verified in Resend, and DIGEST_FROM must be an
#    address on it. Free-provider domains (gmail.com and friends) cannot be
#    verified. Used only when the Gmail pair above is blank.
RESEND_API_KEY=
DIGEST_FROM=

# Subscriber list for the digest. SERVER-SIDE ONLY, never REACT_APP_ prefixed:
# the service key bypasses row-level security. digest_subscribers allows anon
# INSERT but no anon SELECT, so the anon key reads back an empty list.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
